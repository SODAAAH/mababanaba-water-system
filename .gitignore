# Dependencies
node_modules/
deploy/node_modules/

# Environment files & Secrets (CRITICAL: Never commit these!)
.env
.env.local
.env.*.local
*.env

# Active session data & local tokens
api/sessions/*
!api/sessions/.gitkeep
!api/sessions/.htaccess

# User uploads
public/uploads/qr/*
!public/uploads/qr/.gitkeep

# Runtime migration lock files & secrets
api/.migrated*
.secret_key
api/.secret_key

# Logs & scratch debug files
*.log
scratch_*.txt
error_log
api/error_log
tests/error_log

# Local development & testing (not part of core system)
tests/
scripts/*
!scripts/fix-css.js
!scripts/migrate.php
deploy/
scratch/

# OS & IDE metadata
.DS_Store
Thumbs.db
.vscode/
.idea/
.agents/
*.docx
*.pdf



